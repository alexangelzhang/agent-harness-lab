                        </configuration>
                    </execution>
                    <execution>
                        <id>diagnose</id>
                        <configuration>
                            <mainClass>com.example.harness.diagnostics.DiagnoseScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>episodic</id>
                        <configuration>
                            <mainClass>com.example.harness.memory.EpisodicScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>injection</id>
                        <configuration>
                            <mainClass>com.example.harness.security.InjectionScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>topology</id>
                        <configuration>
                            <mainClass>com.example.multiagent.TopologyScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>topologyreal</id>
                        <configuration>
                            <mainClass>com.example.multiagent.TopologyRealScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>supervisorreal</id>
                        <configuration>
                            <mainClass>com.example.multiagent.SupervisorRealScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>parallel</id>
                        <configuration>
                            <mainClass>com.example.multiagent.ParallelFanoutScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>swarmdeadline</id>
                        <configuration>
                            <mainClass>com.example.multiagent.SwarmDeadlineScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stream</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.StreamScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>streamreal</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.StreamRealScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <configuration>
                            <mainClass>com.example.harness.RunReportScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>outerloop</id>
                        <configuration>
                            <mainClass>com.example.harness.OuterLoopScenario</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
