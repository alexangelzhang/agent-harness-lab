                        </configuration>
                    </execution>
                    <execution>
                        <id>toolbase</id>
                        <configuration>
                            <mainClass>com.example.harness.toolbase.ToolbaseScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>hotreload</id>
                        <configuration>
                            <mainClass>com.example.harness.skills.SkillHotReloadScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>skilldoctor</id>
                        <configuration>
