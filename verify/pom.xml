<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>agent-design-patterns</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>agent-verify</artifactId>
    <packaging>jar</packaging>

    <name>agent-verify</name>
    <description>集成验证层：52 个场景（剧本离线可跑 + 真实模型 gated 在 LLM_API_KEY），
        是 agent-core 的可执行规约与回归套件。入口照旧 mvn -q exec:java@id（在仓库根跑，cwd 不变）。</description>

    <dependencies>
        <!-- 核心库 -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>agent-core</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- 场景直接操纵状态图（CompiledGraph/RunnableConfig 等）所需 -->
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
            <version>${langgraph4j.version}</version>
        </dependency>

        <!-- 运行档案的 JSON 序列化（RunRecord 直读场景） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.example.agent.PatternRunner</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>graph</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.PatternsScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>article</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.ArticleScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>real</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.RealScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>realpatterns</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.RealPatternsScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>realadvanced</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.RealAdvancedScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>eval</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.eval.EvalScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>realeval</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.eval.RealEvalScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>foldeval</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.eval.FoldEvalScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>realfoldeval</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.eval.RealFoldEvalScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>judge</id>
                        <configuration>
                            <mainClass>com.example.langgraph4j.JudgeScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>loop</id>
                        <configuration>
                            <mainClass>com.example.agentloop.AgentLoopScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>loopbench</id>
                        <configuration>
                            <mainClass>com.example.agentloop.LoopBenchmark</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>archive</id>
                        <configuration>
                            <mainClass>com.example.harness.RunArchiveScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>gate</id>
                        <configuration>
                            <mainClass>com.example.harness.ToolGateScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>approval</id>
                        <configuration>
                            <mainClass>com.example.harness.ApprovalScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>distill</id>
                        <configuration>
                            <mainClass>com.example.harness.RuleDistillScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>distillreal</id>
                        <configuration>
                            <mainClass>com.example.harness.RuleDistillRealScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>workflow</id>
                        <configuration>
                            <mainClass>com.example.workflow.DynamicWorkflowScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sandbox</id>
                        <configuration>
                            <mainClass>com.example.harness.sandbox.SandboxScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>context</id>
                        <configuration>
                            <mainClass>com.example.harness.context.ContextScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>interaction</id>
                        <configuration>
                            <mainClass>com.example.harness.interaction.InteractionScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>skills</id>
                        <configuration>
                            <mainClass>com.example.harness.skills.SkillsScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>memory</id>
                        <configuration>
                            <mainClass>com.example.harness.memory.MemoryScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>routing</id>
                        <configuration>
                            <mainClass>com.example.harness.routing.RoutingScenario</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>credentials</id>
